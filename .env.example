# API Configuration
# -----------------------------------------------------------------------------
# Set your API base URL here (without trailing slash)
# 
# For production (deployed API):
# NEXT_PUBLIC_API_URL=https://mobulous-tech.vercel.app/api
# 
# For local development:
# NEXT_PUBLIC_API_URL=http://localhost:4500/api
# 
# Copy this file to .env.local and update the value for your environment
# -----------------------------------------------------------------------------

NEXT_PUBLIC_API_URL=https://mobulous-tech.vercel.app/api

# NEXT_PUBLIC_API_URL is embedded at build time. Rebuild/redeploy after changing it.
# Backend CORS_ORIGINS must include the admin site's exact origin and
# http://localhost:3000 for local frontend development.
